# Project paths
PROJECT_ROOT=.
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
ARTIFACT_DIR=artifacts
MODEL_DIR=artifacts/models
LOG_DIR=artifacts/logs
REPORT_DIR=reports

# Optional dataset files. Keep real datasets out of git.
EMNIST_TRAIN_CSV=data/raw/emnist_train.csv
EMNIST_VALIDATION_CSV=data/raw/emnist_validation.csv

# Reproducibility
RANDOM_SEED=42
PYTHONHASHSEED=42

# Training defaults
IMAGE_HEIGHT=28
IMAGE_WIDTH=28
IMAGE_CHANNELS=1
LATENT_DIM=100
BATCH_SIZE=32
EPOCHS=100

# Experiment tracking
EXPERIMENT_NAME=emnist-generative-modeling
MLFLOW_TRACKING_URI=
WANDB_MODE=disabled
